---
export type WorkCardItem = {
  name: string;
  url: string;
  org: string;
  current: boolean;
  status: string;
  note: string;
  icon?: string;
  iconAlt?: string;
};

interface Props {
  items: WorkCardItem[];
}

const { items } = Astro.props;

const displayUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<ul class="works">
  {
    items.map((item) => (
      <li class="reveal">
        <a
          class:list={['card work', { 'work--past': !item.current }]}
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {item.icon && (
            <img
              class="work__icon"
              src={item.icon}
              alt={item.iconAlt ?? ''}
              width="120"
              height="120"
              loading="lazy"
              decoding="async"
            />
          )}

          <div class="work__body">
            <p class="work__meta">
              <span class:list={['work__status mono', { 'work__status--past': !item.current }]}>
                {item.status}
              </span>
              <span class="work__org faint">{item.org}</span>
            </p>

            <h3 class="work__name">{item.name}</h3>
            <p class="work__note muted">{item.note}</p>
            <p class="work__url mono faint">
              {displayUrl(item.url)}
              <span class="work__arrow" aria-hidden="true">↗</span>
            </p>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .works {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
    align-items: start;
  }

  .work {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
    height: 100%;
  }

  /* アイコンを持たないカードは本文だけの1カラムにする */
  .work:not(:has(.work__icon)) {
    grid-template-columns: minmax(0, 1fr);
  }

  .work--past {
    background: transparent;
  }

  /* ロゴは透過 PNG / SVG なので、ブランド色が沈まないよう白いタイルに載せる */
  .work__icon {
    width: clamp(4rem, 10vw, 5rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background: #fff;
    border-radius: 16px;
    border: 1px solid var(--border);
  }

  .work__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .work__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.15rem;
  }

  .work__status {
    padding: 0.15rem 0.55rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    border: 1px solid color-mix(in oklab, var(--accent-2) 45%, transparent);
    border-radius: 999px;
  }

  .work__status--past {
    color: var(--text-faint);
    border-color: var(--border-strong);
  }

  .work__org {
    font-size: 0.76rem;
  }

  .work__name {
    font-size: 1.15rem;
  }

  .work__note {
    font-size: 0.88rem;
  }

  .work__url {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
    font-size: 0.74rem;
  }

  .work__arrow {
    transition: translate 0.25s var(--ease), color 0.25s var(--ease);
  }

  .work:hover .work__arrow {
    translate: 2px -2px;
    color: var(--accent-2);
  }

  @media (max-width: 30rem) {
    .work {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
