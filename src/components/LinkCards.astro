---
import { renderInline } from '~/utils/inline';

export type LinkCardItem = {
  title: string;
  url: string;
  note: string;
  meta?: string;
  /** 掲載元で非公開になったもの。リンクせずラベルだけ出す */
  unavailable?: boolean;
};

interface Props {
  items: LinkCardItem[];
  unavailableLabel?: string;
}

const { items, unavailableLabel } = Astro.props;
---

<ul class="cards grid grid--2">
  {
    items.map((item) => (
      <li class="reveal">
        <div class:list={['card linkcard', { 'linkcard--muted': item.unavailable }]}>
          {(item.meta || item.unavailable) && (
            <p class="linkcard__meta">
              {item.meta && <span class="mono faint">{item.meta}</span>}
              {item.unavailable && unavailableLabel && (
                <span class="linkcard__badge mono">{unavailableLabel}</span>
              )}
            </p>
          )}

          <h3 class="linkcard__title">
            {item.unavailable ? (
              item.title
            ) : (
              <a class="linkcard__anchor" href={item.url} target="_blank" rel="noopener noreferrer">
                {item.title}
                <span class="linkcard__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            )}
          </h3>

          <p class="linkcard__note muted" set:html={renderInline(item.note)} />
        </div>
      </li>
    ))
  }
</ul>

<style>
  .linkcard {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
  }

  /* 非公開のものは読みに行けないので、控えめに見せる */
  .linkcard--muted {
    background: transparent;
  }

  .linkcard--muted .linkcard__title {
    color: var(--text-muted);
  }

  /* カード全面をクリック領域にする */
  .linkcard__anchor::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  /* 本文中のリンクは全面オーバーレイの上に出さないと押せない */
  .linkcard__note :global(a) {
    position: relative;
    z-index: 1;
  }

  .linkcard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }

  .linkcard__badge {
    padding: 0.1rem 0.5rem;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
  }

  .linkcard__title {
    font-size: 1rem;
    line-height: 1.55;
  }

  .linkcard__arrow {
    display: inline-block;
    margin-left: 0.3rem;
    color: var(--text-faint);
    transition: translate 0.25s var(--ease), color 0.25s var(--ease);
  }

  .card:hover .linkcard__arrow {
    translate: 2px -2px;
    color: var(--accent-2);
  }

  .linkcard__note {
    font-size: 0.87rem;
  }
</style>
