---
export type ValueItem = {
  title: string;
  notes: string[];
};

interface Props {
  items: ValueItem[];
  numbered?: boolean;
}

const { items, numbered = false } = Astro.props;
---

<ul class="values grid grid--2">
  {
    items.map((item, index) => (
      <li class="card value reveal">
        {numbered && <span class="value__index mono faint">{String(index + 1).padStart(2, '0')}</span>}
        <h3 class="value__title">{item.title}</h3>
        {item.notes.length > 0 && (
          <ul class="value__notes muted">
            {item.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>

<style>
  .value {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .value__index {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }

  .value__title {
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .value__notes {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .value__notes li {
    position: relative;
    padding-left: 0.9rem;
  }

  .value__notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.35rem;
    height: 1px;
    background: var(--accent-2);
  }
</style>
